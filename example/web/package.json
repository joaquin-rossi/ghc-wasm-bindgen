{
  "name": "shape-example",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run wasm && esbuild src/main.ts --bundle --format=esm --outfile=dist/main.js --servedir=. --serve=8000",
    "typecheck": "tsc --noEmit -p .",
    "bundle": "npm run wasm && esbuild src/main.ts --bundle --format=esm --outfile=dist/main.js",
    "wasm": "mkdir -p dist && cp node_modules/shape/src/shape.wasm dist/"
  },
  "dependencies": {
    "shape": "file:../wrapper"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
